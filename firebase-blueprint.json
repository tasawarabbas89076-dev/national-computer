{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A computer, laptop, peripheral, or hardware accessory in inventory",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "categoryLabel": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 2000 },
        "price": { "type": "string", "maxLength": 50 },
        "currency": { "type": "string", "maxLength": 10 },
        "image": { "type": "string", "maxLength": 1000 },
        "badge": { "type": "string", "maxLength": 50 },
        "isActive": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["name", "category", "price"]
    },
    "Category": {
      "title": "Category",
      "description": "Product classification category",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "slug": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["name", "slug"]
    },
    "Service": {
      "title": "Service",
      "description": "Computer repair or technical IT support service offered by National Computer",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "turnaround": { "type": "string", "maxLength": 100 },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["title", "description"]
    },
    "WebsiteContent": {
      "title": "WebsiteContent",
      "description": "Store contact details and customizable homepage/public text",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "heroTitle": { "type": "string", "maxLength": 300 },
        "heroDescription": { "type": "string", "maxLength": 2000 },
        "heroImage": { "type": "string", "maxLength": 1000 },
        "phone": { "type": "string", "maxLength": 50 },
        "whatsappNumber": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 150 },
        "address": { "type": "string", "maxLength": 500 },
        "hours": { "type": "string", "maxLength": 300 },
        "footerText": { "type": "string", "maxLength": 1000 },
        "updatedAt": { "type": "string", "maxLength": 100 }
      }
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized administrator user profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Public catalog of hardware products, managed by admins"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Categories for grouping products, managed by admins"
    },
    "/services/{serviceId}": {
      "schema": "Service",
      "description": "Public list of technical repair services, managed by admins"
    },
    "/content/{contentId}": {
      "schema": "WebsiteContent",
      "description": "Site-wide configuration and editable content blocks"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Designated administrator UIDs with management access"
    }
  }
}
